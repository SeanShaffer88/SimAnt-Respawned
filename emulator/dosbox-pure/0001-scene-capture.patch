+extern "C" RETRO_API bool retro_set_scene_capture_v1(const uint32_t* offset_lengths, uint32_t range_count)
+{
+	if (range_count > DBP_SCENE_MAX_RANGES || (range_count && !offset_lengths))
+		return false;
+
+	uint32_t total = 0, required_size = 0;
+	for (uint32_t i = 0; i < range_count; ++i)
+	{
+		const uint32_t offset = offset_lengths[2 * i], length = offset_lengths[2 * i + 1];
+		if (!length || offset >= DBP_CONVENTIONAL_END ||
+			length > DBP_CONVENTIONAL_END - offset || length > DBP_SCENE_MAX_BYTES - total)
+			return false;
+		if (offset + length > required_size)
+			required_size = offset + length;
+		total += length;
+	}
+
+	for (uint32_t i = 0; i < range_count; ++i)
+	{
+		dbp_scene.ranges[i].offset = offset_lengths[2 * i];
+		dbp_scene.ranges[i].length = offset_lengths[2 * i + 1];
+	}
+	dbp_scene.range_count = range_count;
+	dbp_scene.required_size = required_size;
+	dbp_scene.captured_size = 0;
+	return true;
+}
+
+extern "C" RETRO_API uint32_t retro_get_scene_capture_v1(uint8_t* destination, uint32_t capacity,
+	uint64_t* sequence, uint32_t* width, uint32_t* height)
+{
+	if (!dbp_scene.captured_size || capacity < dbp_scene.captured_size ||
+		!destination || !sequence || !width || !height)
+		return 0;
+	memcpy(destination, dbp_scene.bytes, dbp_scene.captured_size);
+	*sequence = dbp_scene.sequence;
+	*width = dbp_scene.width;
+	*height = dbp_scene.height;
+	return dbp_scene.captured_size;
+}
+
+static void DBP_CaptureSceneFrame(const DBP_Buffer& buffer)
+{
+	if (dbp_scene.has_last_draw && dbp_scene.last_draw == dbp_framecount)
+		return;
+	dbp_scene.last_draw = dbp_framecount;
+	dbp_scene.has_last_draw = true;
+
+	if (!dbp_scene.range_count || !dbp_game_running || DOSBox_Boot || !MemBase ||
+		!buffer.video || !buffer.width || !buffer.height ||
+		dbp_scene.program_offset >= DBP_CONVENTIONAL_END ||
+		dbp_scene.required_size > DBP_CONVENTIONAL_END - dbp_scene.program_offset ||
+		dbp_scene.sequence == UINT64_MAX)
+		return;
+
+	const uint8_t* program_ram = MemBase + dbp_scene.program_offset;
+	uint32_t copied = 0;
+	for (uint32_t i = 0; i < dbp_scene.range_count; ++i)
+	{
+		const DBP_SceneCapture::Range& range = dbp_scene.ranges[i];
+		memcpy(dbp_scene.bytes + copied, program_ram + range.offset, range.length);
+		copied += range.length;
+	}
+	dbp_scene.width = buffer.width;
+	dbp_scene.height = buffer.height;
+	++dbp_scene.sequence;
+	dbp_scene.captured_size = copied;
+}
+
+static void DBP_ResetSceneCapture()
+{
+	dbp_scene.range_count = 0;
+	dbp_scene.captured_size = 0;
+	dbp_scene.sequence = 0;
+	dbp_scene.has_last_draw = false;
+	dbp_scene.program_offset = DBP_CONVENTIONAL_END;
+}
